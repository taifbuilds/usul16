DATABASE_URL=sqlite:///./eshia_research.db
# Postgres example:
# DATABASE_URL=postgresql+psycopg2://eshia:eshia@localhost:5432/eshia_research

# Public API security. Leave API_ADMIN_TOKEN empty to disable every editorial
# write. Generate a long random value only for a private admin deployment.
API_ADMIN_TOKEN=
API_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_ENABLE_DOCS=false

CRAWL_DELAY_SECONDS=0.05
CRAWL_MAX_RETRIES=3
CRAWL_TIMEOUT_SECONDS=20
CRAWL_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
CRAWL_BASE_URL=https://lib.eshia.ir
STORE_RAW_HTML=true

# When true, crawl-library only processes books with crawl_priority set
# (see the set-priority CLI command) instead of the whole DB. Useful for
# launching on a hand-picked subset (e.g. the core hadith collections)
# before the full ~3.5M-page crawl finishes.
CRAWL_PRIORITY_ONLY=false

# Concurrency: how many pages crawl-book fetches in parallel once it knows
# a volume's page range (see README's "Fast crawling" section). Set to 1 to
# fall back to the old sequential one-page-at-a-time behaviour.
# CRAWL_DELAY_SECONDS stops being a meaningful safety net on its own once
# concurrency > 1 (each worker "waiting politely" independently is still
# concurrency-times the load) — the throttle settings below are what
# actually protects against hammering a struggling server.
CRAWL_CONCURRENCY=10

# Adaptive throttle (shared circuit breaker across all concurrent workers):
# if CRAWL_THROTTLE_ERROR_RATE of the last CRAWL_THROTTLE_WINDOW requests
# were retryable errors (429/500/502/503/504), every worker pauses for
# CRAWL_THROTTLE_COOLDOWN_SECONDS before sending another request. This is
# what's actually doing the protective work at these speed settings.
CRAWL_THROTTLE_WINDOW=20
CRAWL_THROTTLE_ERROR_RATE=0.3
CRAWL_THROTTLE_COOLDOWN_SECONDS=10
