[Unit]
Description=Usul16 FastAPI Backend
After=network.target

[Service]
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/app/eshia-research
EnvironmentFile=/home/deploy/app/eshia-research/.env
ExecStart=/home/deploy/app/eshia-research/.venv/bin/uvicorn eshia_research.api.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
